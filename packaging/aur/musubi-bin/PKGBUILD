# Maintainer: Koxility <https://github.com/Koxility>

pkgname=musubi-bin
_pkgname=musubi
pkgver=0.4.2
pkgrel=1
pkgdesc='Stream anime from Jellyfin and keep your AniList in sync (prebuilt binary)'
arch=('x86_64')
url='https://github.com/Koxility/musubi'
license=('MIT' 'OFL-1.1')
depends=(
  'gcc-libs'
  'glibc'
  'glib2'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-libav'
  'hicolor-icon-theme'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
)
optdepends=(
  'org.freedesktop.secrets: keep login tokens in the desktop keyring (KWallet, GNOME Keyring)'
  'gst-plugin-va: hardware video decoding through VA-API'
  'vulkan-icd-loader: GPU rendering through Vulkan instead of OpenGL'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('9702035af9b43b86f941aac158fbea5e7cbb3ddcd31a2a605c2338d93567116b')

package() {
  cd "$_pkgname-$pkgver-x86_64-linux"
  install -Dm755 musubi -t "$pkgdir/usr/bin/"
  install -Dm644 musubi.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 musubi.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  # The binary embeds fonts under the OFL; which ones differs between versions.
  install -Dm644 LICENSE ./*-OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
