{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "react-devtools-core": [
        "./src/stubs/devtools.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
